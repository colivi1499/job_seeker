# Copy to .env and fill in values:
# cp .env.example .env

# Adzuna job ingest (required for python -m backend.ingest.run)
# Get keys at https://developer.adzuna.com/
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Optional: LLM query parsing (before embedding search)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
USE_LLM_QUERY_PARSE=true
